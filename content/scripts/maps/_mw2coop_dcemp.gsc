// mw2coop: "Second Sun" (dcemp) for two players after the crash site (maps\_mw2coop_crashsite):
// the ISS and coming back from the EMP white-out. Called from mw2coop/patches/maps/dcemp.gsc.patch
// and dcemp_code.gsc.patch (generated by tools/gen_dcemp_patches.py); outside a co-op campaign
// session every entry point does what the original code did.
//
// ISS: player 2 floats beside player 1 (a second camera following the first one). After the EMP
// flash each player is back in his own place in the wreck, and both are let out.
#include common_scripts\utility;
#include maps\_utility;
#include maps\_anim;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// iss_camera_setup(): player 2's camera floats beside player 1's and follows it. Both players' bodies and their
// names are hidden in space: the two cameras float side by side, and each player saw the other one's body (and his
// name) in the picture (testers, 2026-11-06). players_empaftermath() shows them again.
partner_iss_camera( camera )
{
	if ( !coop() )
		return;
	p2 = level.player2;
	level.mw2coop_bodies_hidden = true;	// (maps\_mw2coop::partner_overlap leaves them alone)
	level.player Hide();
	p2 Hide();
	SetDvar( "mw2coop_hide_names", "1" );
	// nor the partner's marker (maps\_coop's green diamond at the screen edge): it showed in both views, in space too
	level.mw2coop_iss_icon = false;
	if ( flag_exist( "coop_show_constant_icon" ) && flag( "coop_show_constant_icon" ) )
	{
		level.mw2coop_iss_icon = true;
		flag_clear( "coop_show_constant_icon" );
	}
	p2 AllowCrouch( false );
	p2 AllowProne( false );
	p2 FreezeControls( true );
	cam2 = Spawn( "script_model", camera.origin );
	cam2 SetModel( "tag_origin" );
	cam2.angles = camera.angles;
	cam2 LinkTo( camera, "tag_origin", ( 0, -64, 0 ), ( 0, 0, 0 ) );
	level.mw2coop_iss_camera = cam2;
	p2 PlayerLinkToDelta( cam2, "tag_origin", 1, 0, 0, 0, 0 );
	p2 PlayerSetGroundReferenceEnt( cam2 );
	maps\_mw2coop::state( "iss: player 2 floats beside player 1" );
}

// iss_main(): player 2's view and stance are kept for after the EMP, as player 1's are.
save_partner_view()
{
	if ( !coop() )
		return;
	p2 = level.player2;
	p2.mw2coop_emp_angles = p2 GetPlayerAngles();
	p2.mw2coop_emp_stance = p2 GetStance();
	p2 DisableWeapons();
	p2 FreezeControls( true );
	p2 AllowCrouch( false );
	p2 SetStance( "stand" );
}

// self: player, in emp_empaftermath().
emp_angles()
{
	if ( coop() && self != level.player && isdefined( self.mw2coop_emp_angles ) )
		return self.mw2coop_emp_angles;
	return level.emp_player_angles;
}

emp_stance()
{
	if ( coop() && self != level.player && isdefined( self.mw2coop_emp_stance ) )
		return self.mw2coop_emp_stance;
	return level.emp_player_stance;
}

// emp_main(): every player comes back from the white-out in his place in the wreck.
players_empaftermath()
{
	if ( coop() )
	{
		level.player Show();
		level.player2 Show();
		level.mw2coop_bodies_hidden = undefined;
		SetDvar( "mw2coop_hide_names", "" );
		if ( isdefined( level.mw2coop_iss_icon ) && level.mw2coop_iss_icon && flag_exist( "coop_show_constant_icon" ) )
			flag_set( "coop_show_constant_icon" );
	}
	foreach ( player in maps\_mw2coop_crashsite::crash_players() )
		player thread maps\dcemp::emp_empaftermath();
	if ( coop() && isdefined( level.mw2coop_iss_camera ) )
		level.mw2coop_iss_camera Delete();
}

// Every player is let out of the wreck (player 2 a moment after player 1, beside him).
players_free()
{
	level.player thread maps\dcemp::emp_free_player();
	if ( coop() )
		level.player2 delayThread( 0.6, maps\dcemp::emp_free_player );
}

// self: player in emp_free_player(): where his move out of the wreck ends.
free_exit_origin( end )
{
	if ( !coop() || self == level.player )
		return end.origin;
	right = AnglesToRight( ( 0, end.angles[ 1 ], 0 ) );
	for ( side = 1; side >= -1; side -= 2 )
	{
		at = end.origin + right * ( 40 * side );
		floor = PlayerPhysicsTrace( at + ( 0, 0, 30 ), at - ( 0, 0, 60 ) );
		if ( abs( floor[ 2 ] - end.origin[ 2 ] ) < 20 && BulletTracePassed( end.origin + ( 0, 0, 30 ), at + ( 0, 0, 30 ), false, undefined ) )
			return floor;
	}
	return end.origin;
}

// --------------------------------------------------------------------------------------------
// The street: a falling helicopter chases the player until he hides with the team. In co-op
// each player has his own, the street counts as safe once both have hidden, and "too far out
// in the open" (street_insta_death) is each player's own.

street_monitor()
{
	if ( !coop() )
		return;
	hide = flag_triggers( "street_player_hide" );
	death = flag_triggers( "street_insta_death" );
	while ( !flag( "street_safe" ) )
	{
		foreach ( player in level.players )
		{
			foreach ( trigger in hide )
				if ( player IsTouching( trigger ) )
					player.mw2coop_street_hidden = true;
			foreach ( trigger in death )
				if ( player IsTouching( trigger ) )
					player.mw2coop_street_exposed = true;
		}
		wait 0.05;
	}
}

flag_triggers( name )
{
	found = [];
	foreach ( trigger in getEntArrayWithFlag( name ) )
		found[ found.size ] = trigger;
	return found;
}

// street_hide_moment(): the street is safe once every player has hidden (player 1 outside co-op).
wait_players_hidden()
{
	if ( !coop() )
	{
		flag_wait( "street_player_hide" );
		return;
	}
	for ( ;; )
	{
		all = true;
		foreach ( player in level.players )
			if ( IsAlive( player ) && !isdefined( player.mw2coop_street_hidden ) )
				all = false;
		if ( all )
			break;
		wait 0.05;
	}
	maps\_mw2coop::state( "dcemp street: both players hidden" );
}

// street_main(): a falling helicopter for every player.
street_helis()
{
	if ( !coop() )
	{
		level.player thread maps\dcemp_code::street_heli_player_kill();
		return;
	}
	thread street_monitor();
	foreach ( player in level.players )
		player thread maps\dcemp_code::street_heli_player_kill();
}

// self: the player a helicopter chases.
street_safe_for()
{
	if ( !coop() )
		return flag( "street_safe" );
	return flag( "street_safe" ) || isdefined( self.mw2coop_street_hidden );
}

street_insta_death_for()
{
	if ( !coop() )
		return flag( "street_insta_death" );
	return isdefined( self.mw2coop_street_exposed );
}

// --------------------------------------------------------------------------------------------
// The street after the EMP (dcemp_code.gsc; night audit 2026-11-17).

// do_player_crash_fx(): a helicopter crashes beside the street. Within 1500 units the player's pad shakes and he is jolted up; within 650 he is
// knocked into a crouch for a second, slowed and out of breath. Player 1 alone was; player 2 the same by his own distance (the earthquake is the
// level's, for both).
partner_crash_fx( origin )
{
	if ( !coop() || !IsAlive( level.player2 ) || maps\_mw2coop::is_downed( level.player2 ) )
		return;
	p2 = level.player2;
	dist = DistanceSquared( p2.origin, origin );
	if ( dist >= squared( 1500 ) )
		return;
	p2 PlayRumbleLoopOnEntity( "tank_rumble" );
	p2 delaycall( 1.0, ::stopRumble, "tank_rumble" );
	if ( !p2 IsLinked() )
		p2 SetVelocity( AnglesToUp( p2.angles ) * 210 );
	if ( dist >= squared( 650 ) )
		return;
	p2 AllowStand( false );
	p2 AllowProne( false );
	p2 SetStance( "crouch" );
	p2 blend_movespeedscale( .5 );
	p2 delayThread( .1, ::playLocalSoundWrapper, "breathing_hurt" );
	time = 1;
	p2 delayThread( .5, ::blend_movespeedscale, .8, 1.0 );
	p2 delayThread( time + .25, ::playLocalSoundWrapper, "breathing_better" );
	p2 delaycall( time, ::allowStand, true );
	p2 delaycall( time, ::allowProne, true );
	p2 delaycall( time, ::setstance, "stand" );
	maps\_mw2coop::state( "dcemp street: a crash " + int( sqrt( dist ) ) + " units from player 2 knocks him down" );
}

// street_hide_moment(): after the helicopters the level hands player 1 a Beretta and fills his rifle, grenade launcher, frags and flashes. Player 2
// gets the same (the Beretta itself reaches him through the weapon sync a moment later).
partner_street_ammo()
{
	if ( !coop() || !IsAlive( level.player2 ) )
		return;
	wait 0.5;
	p2 = level.player2;
	if ( !p2 HasWeapon( "Beretta" ) )
		p2 GiveWeapon( "Beretta" );
	p2 SetWeaponAmmoClip( "Beretta", 30 );
	p2 SetWeaponAmmoStock( "Beretta", 90 );
	p2 SetWeaponAmmoStock( "m4m203_eotech", 300 );
	p2 SetWeaponAmmoStock( "m203_m4_eotech", 9 );
	p2 SetWeaponAmmoStock( "fraggrenade", 4 );
	p2 SetWeaponAmmoStock( "flash_grenade", 4 );
	maps\_mw2coop::state( "dcemp street: player 2's ammo refilled as player 1's" );
}
