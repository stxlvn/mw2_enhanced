// mw2coop: Of Their Own Accord (dcburning) for two players. Called from
// mw2coop/patches/maps/dcburning.gsc.patch (generated by tools/gen_dcburning_patches.py); outside
// a co-op campaign session every entry point does nothing.
//
// The Black Hawk ride over Washington: player 1 mans the door minigun as before; player 2 rides in
// the cabin as a passenger and shoots out with his own weapon (owner, 2026-10-22: as COD-MOD did;
// before, he stayed on the roof). Both are invulnerable on board as player 1 alone was, through
// the crash; the crash site then takes both over (maps\_mw2coop_crashsite).
#include common_scripts\utility;
#include maps\_utility;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// Player 1 gets on the minigun (or a start point puts him there). Player 2 rides at the
// helicopter's passenger tag, tag_playerride, linked as COD-MOD does (PlayerLinkTo: his view keeps
// the world's up; a seat linked with the helicopter's angles turned his view upside down as it
// banked, QA 2026-10-22).
partner_boards()
{
	if ( !coop() || isdefined( level.mw2coop_heli_rider ) || !isdefined( level.blackhawk ) )
		return;
	level.mw2coop_heli_rider = level.player2;
	p2 = level.player2;
	p2 EnableInvulnerability();
	p2 AllowProne( false );
	p2 AllowSprint( false );
	p2 AllowJump( false );
	p2 PlayerLinkTo( partner_seat(), "tag_origin", 1, 180, 180, 40, 40 );
	p2 EnableWeapons();
	maps\_mw2coop::state( "dcburning: player 2 rides in the Black Hawk's cabin" );
}

// Player 2's place in the cabin. tag_playerride is 26 units from the gunner's tag_player, at the same door: the two eyes were 23 units apart, the bodies were
// hidden as overlapping (maps\_mw2coop players_overlap), and player 2 saw the minigun with nobody behind it, from inside player 1's head (owner's screenshot
// 2026-11-27, QA heliview). His place is 26 units further in, toward the cabin's middle, on the same floor: 48 units from the gunner, who is seen at his gun,
// with the door and the city over the gunner's shoulder. A tag_origin linked to the helicopter where it stands keeps him there.
partner_seat()
{
	if ( isdefined( level.mw2coop_heli_seat ) )
		return level.mw2coop_heli_seat;
	heli = level.blackhawk;
	seat = spawn_tag_origin();
	seat.origin = heli GetTagOrigin( "tag_playerride" ) - AnglesToRight( heli.angles ) * 26;
	seat.angles = heli GetTagAngles( "tag_playerride" );
	seat LinkTo( heli, "tag_playerride" );
	level.mw2coop_heli_seat = seat;
	return seat;
}

// The missile hits: like player 1 he puts his weapon away and holds on, his view narrowed.
partner_holds_on()
{
	if ( !coop() || !isdefined( level.mw2coop_heli_rider ) )
		return;
	level.player2 DisableWeapons();
	level.player2 PlayerLinkTo( partner_seat(), "tag_origin", 1, 20, 20, 10, 10 );
}

// The screen is black and the wreck goes away: off the helicopter, for the crash site.
partner_lets_go()
{
	if ( !isdefined( level.mw2coop_heli_rider ) )
		return;
	if ( level.player2 IsLinked() )
		level.player2 Unlink();
	level.player2 AllowProne( true );
	level.player2 AllowSprint( true );
	level.player2 AllowJump( true );
	level.mw2coop_heli_rider = undefined;
	if ( isdefined( level.mw2coop_heli_seat ) )
		level.mw2coop_heli_seat Delete();
	level.mw2coop_heli_seat = undefined;
}

// --------------------------------------------------------------------------------------------
// The Barrett on the Crow's Nest (maps\_barrett exchange_barrett_trigger, patched by tools/gen_dcburning_patches.py; night audit 2026-11-17): its use
// trigger answered either player, but the level put player 1 on the rifle wherever he stood. Now whoever uses it gets on it; the rifle's shots,
// recoil shock, zoom lesson and the enemies' warning shots (dcburning.gsc player_barrett_damage) are his.

// The use trigger's user (player 1 when the trigger did not say).
barrett_got_on( user )
{
	if ( !isdefined( user ) || !is_in_array( level.players, user ) )
		user = level.player;
	level.mw2coop_barrett_user = user;
	if ( coop() )
		maps\_mw2coop::state( "barrett: " + maps\_mw2coop::player_label( user ) + " gets on the rifle" );
	return user;
}

barrett_got_off()
{
	level.mw2coop_barrett_user = undefined;
}

// The player on the rifle (player 1 when nobody is).
barrett_user()
{
	if ( isdefined( level.mw2coop_barrett_user ) && IsAlive( level.mw2coop_barrett_user ) )
		return level.mw2coop_barrett_user;
	return level.player;
}

barrett_attack_pressed()
{
	user = barrett_user();
	return user AttackButtonPressed();
}

barrett_movement()
{
	user = barrett_user();
	return user GetNormalizedMovement();
}

// Player 1 got on the rifle: the level turned his weapons and night-vision slot off, and src/mirror.c did the same to player 2, who is not on it.
// He gets them back (src/mirror.c mirrors calls on player 1 to player 2 unconditionally; this scene is player 1's alone).
barrett_partner_kit( user )
{
	if ( !coop() || user != level.player || !IsAlive( level.player2 ) )
		return;
	level.player2 EnableWeapons();
	if ( level.script == "dcburning" )
		level.player2 SetActionSlot( 1, "nightvision" );
	maps\_mw2coop::state( "barrett: player 2 keeps his weapons and night vision while player 1 is on the rifle" );
}
